@startuml
start

title "Activity – Enemy AI (Direction / Planned)"

note right
  Current repo state:
  - EnemyAISystem is a stub: src/app/systems/EnemyAISystem.cpp
  - Supporting domain services already exist:
    * LOS: src/domain/services/LOS.cpp
    * Pathfinding: src/domain/services/Pathfinding.cpp
end note

' If resting, check line of sight once
if (State is Resting?) then (yes)
  if (Has LOS to player?) then (yes)
    :Set state to Chasing;
  else (no)
    :Idle (no action);
    stop
  endif
endif

' Chasing behavior
if (State is Chasing?) then (yes)
  if (Adjacent to player?) then (yes)
    :Attack player;
  else (no)
    :Choose one-step path toward player;
    if (Step available AND passable AND not occupied?) then (yes)
      :Move one cell toward player;
    else (no)
      :Set state to Resting (lost target);
    endif
  endif
else (no)
  :Idle (no action);
endif

stop
@enduml
