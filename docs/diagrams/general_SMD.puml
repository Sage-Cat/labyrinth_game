@startuml
title "State Machine – Executable Flow (Current)"

[*] --> Boot

state Boot {
  [*] --> ParseCLI
  ParseCLI --> NewGame : no --load
  ParseCLI --> LoadGame : --load=<path>

  NewGame --> Ready : NewGameUseCase ok
  NewGame --> [*] : fail -> exit code 11

  LoadGame --> Ready : LoadGameUseCase ok
  LoadGame --> [*] : fail -> exit code 10
}

Boot --> Running : Ready
Running --> Exited : q / CmdQuit
Running --> Exited : no input (EOF)
Running --> Exited : unhandled exception

state "Planned (not implemented yet)" as Planned {
  Running --> Victory : state.victory == true
  Running --> Defeat  : state.defeat == true
}

Victory --> Exited
Defeat  --> Exited
Exited --> [*]
@enduml
